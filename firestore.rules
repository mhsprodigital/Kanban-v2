rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: units
    // Fields:
    //   - name: string (required)
    //   - capacity: number (required)
    //   - bedNames: list of strings (optional)
    //
    // Collection: patients
    // Fields:
    //   - unitId: string (required)
    //   - bed: string (required)
    //   - sesId: string (required)
    //   - name: string (required)
    //   - gender: string (optional)
    //   - age: number (optional)
    //   - entryDateHospital: string (optional)
    //   - admissionDate: string (optional)
    //   - dischargeDate: string (optional)
    //   - origin: string (optional)
    //   - externalDestination: string (optional)
    //   - diagnosis: string (optional)
    //   - etiologicalAgent: string (optional)
    //   - pendingTasks: list of objects (optional)
    //   - status: string (required)
    //   - isolationType: string (optional)
    //   - isExtra: boolean (optional)
    //   - blockReason: string (optional)
    //
    // Collection: movements
    // Fields:
    //   - patientId: string (required)
    //   - patientName: string (required)
    //   - type: string (required)
    //   - date: string (required)
    //   - fromUnit: string (optional)
    //   - toUnit: string (optional)
    //   - bed: string (required)
    //   - collaborator: map (required)
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidString(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }

    function isValidUnit(data) {
      return data.keys().hasAll(['name', 'capacity']) &&
             isValidString(data.name, 1, 100) &&
             data.capacity is number && data.capacity >= 0 &&
             (!('bedNames' in data) || data.bedNames is list);
    }

    function isValidPatient(data) {
      return data.keys().hasAll(['unitId', 'bed', 'name', 'sesId', 'status']) &&
             isValidString(data.name, 1, 200) &&
             isValidString(data.sesId, 1, 50) &&
             isValidString(data.unitId, 1, 100) &&
             isValidString(data.bed, 1, 50) &&
             isValidString(data.status, 1, 50) &&
             (!('diagnosis' in data) || isValidString(data.diagnosis, 0, 5000)) &&
             (!('origin' in data) || isValidString(data.origin, 0, 200));
    }

    function isValidMovement(data) {
      return data.keys().hasAll(['patientId', 'patientName', 'type', 'date', 'bed', 'collaborator']) &&
             isValidString(data.patientId, 1, 100) &&
             isValidString(data.patientName, 1, 200) &&
             isValidString(data.type, 1, 50) &&
             isValidString(data.date, 1, 50) &&
             isValidString(data.bed, 1, 50) &&
             data.collaborator is map &&
             data.collaborator.keys().hasAll(['name', 'category']);
    }

    match /units/{unitId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidUnit(request.resource.data);
      allow update: if isAuthenticated() && isValidUnit(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /patients/{patientId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPatient(request.resource.data);
      allow update: if isAuthenticated() && isValidPatient(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /movements/{movementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidMovement(request.resource.data);
      allow update: if isAuthenticated() && isValidMovement(request.resource.data);
      allow delete: if isAuthenticated();
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserAdminInDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          (getUserData().get('role', '') == 'admin' || getUserData().get('role', '') == 'Admin') ||
          (getUserData().get('category', '') == 'Administrador' || getUserData().get('category', '') == 'admin' || getUserData().get('category', '') == 'Administradora')
        );
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (request.auth.token.email == "mhs.pro.digital@gmail.com") ||
          (request.auth.token.email == "matheus.sousa@hrt.local") ||
          isUserAdminInDoc() ||
          (exists(/databases/$(database)/documents/invitations/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/invitations/$(request.auth.uid)).data.get('role', '') == 'admin')
        );
    }

    function isValidInvitation(data) {
      return data.keys().hasAll(['username', 'name', 'role', 'authEmail', 'authVersion', 'status', 'resetRequested']) &&
             isValidString(data.username, 1, 50) &&
             isValidString(data.name, 1, 100) &&
             data.role in ['admin', 'user'] &&
             data.status in ['pending', 'active', 'blocked'] &&
             data.resetRequested is bool &&
             (!('setor' in data) || isValidString(data.setor, 0, 100)) &&
             (!('cargo' in data) || isValidString(data.cargo, 0, 100));
    }

    match /invitations/{username} {
      allow get: if true;
      allow list: if isAuthenticated();
      
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (username == 'admin' && !exists(/databases/$(database)/documents/invitations/admin) && request.resource.data.role == 'admin') ||
        (username == 'matheus.sousa' && request.resource.data.role == 'admin')
      );
        
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && isAdmin();
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'username', 'name', 'role', 'status']) &&
             isValidString(data.uid, 1, 100) &&
             isValidString(data.username, 1, 50) &&
             isValidString(data.name, 1, 100) &&
             data.role in ['admin', 'user'] &&
             data.status in ['active', 'blocked', 'pending'] &&
             (!('category' in data) || isValidString(data.category, 0, 100)) &&
             (!('email' in data) || isValidString(data.email, 0, 100)) &&
             (!('createdAt' in data) || isValidString(data.createdAt, 0, 50));
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /access_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false; // Logs should not be updated
      allow delete: if isAuthenticated() && isAdmin();
    }
  }
}
